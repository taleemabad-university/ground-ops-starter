#!/usr/bin/env bash
# How you start things.
#
#   ./run                    EVERYTHING on this machine  (trying things out, solo)
#   ./run board              ONLY the board + feeds      (whoever hosts it for the team)
#   ./run mine assigner-A    ONLY your piece, pointed at $BOARD_URL from team.env
#   ./run fresh [mode]       same, but wipe board.db first (the board persists!)
#
# On a four-person team you almost always want the last one. There is ONE board.
set -uo pipefail
cd "$(dirname "$0")"
PY="${PYTHON:-python3}"
pids=()
cleanup(){ echo; echo "stopping…"; for p in "${pids[@]:-}"; do kill "$p" 2>/dev/null; done; }
trap cleanup EXIT INT TERM

show(){ "$PY" -c 'import board.config as c; print(c.describe())'; }

# `./run fresh ...` wipes board.db first
if [ "${1:-}" = "fresh" ]; then
  shift
  rm -f board.db && echo "board.db wiped — starting empty"
fi

case "${1:-all}" in
  mine)
    piece="${2:-}"
    case "$piece" in
      assigner-A) mod=(assigners.naive A 8101) ;;
      assigner-B) mod=(assigners.naive B 8102) ;;
      replanner)  mod=(replanner.naive 8103)   ;;
      monitor)    mod=(monitor.naive 8104)     ;;
      *) echo "which piece? assigner-A | assigner-B | replanner | monitor"; exit 2 ;;
    esac
    echo "running $piece against the team board:"; show; echo
    exec "$PY" -m "${mod[@]}"
    ;;

  board)
    echo "hosting the board for the team. everyone points BOARD_URL here."
    "$PY" -m board.serve & pids+=($!)
    sleep 1
    echo "  tell your team:  BOARD_URL=http://$(ipconfig getifaddr en0 2>/dev/null || hostname):8080"
    wait
    ;;

  all)
    "$PY" -m board.serve & pids+=($!)
    sleep 1.2
    "$PY" -m assigners.naive A 8101 & pids+=($!)
    "$PY" -m assigners.naive B 8102 & pids+=($!)
    "$PY" -m replanner.naive  8103  & pids+=($!)
    "$PY" -m monitor.naive    8104  & pids+=($!)
    cat <<'BANNER'

  everything is up ON THIS MACHINE. fine for trying things out — but a team of
  four needs ONE board with four pieces pointing at it. see `./run --help`.

BANNER
    show
    cat <<'BANNER'

  watch it:   http://localhost:8080/
  break it:   ./inject late   (or close-runway | race | bad-clock | no-gate | all)
  ctrl-c to stop.

BANNER
    wait
    ;;

  -h|--help)  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown mode: $1 — try: (nothing) | board | mine <piece> | --help"; exit 2 ;;
esac
