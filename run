#!/usr/bin/env bash
# mac / linux wrapper. The real launcher is run.py (same on every OS).
#   ./run            everything on this machine
#   ./run board      just the board, for the team to point at
#   ./run mine assigner-A
#   ./run fresh      wipe board.db first
set -uo pipefail
cd "$(dirname "$0")"
PY="${PYTHON:-}"
if [ -z "$PY" ]; then
  command -v python3 >/dev/null 2>&1 && PY=python3 || PY=python
fi
exec "$PY" run.py "$@"
