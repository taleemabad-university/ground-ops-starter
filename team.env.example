# Copy to `team.env` and commit it. ONE board for the whole team; everyone's
# pieces point at it. This file is the machine-readable half of contracts.md —
# if an address changes, that is a contract change and you tell people (SLO 11).
#
#   cp team.env.example team.env

# Whoever is hosting the board. `./run board` prints the address to use.
BOARD_URL=http://127.0.0.1:8080

# Where each person's piece is reachable. Not localhost — the address a
# TEAMMATE can hit (SLO 4). `./run me` prints yours (Windows: `.\run.cmd me`).
ASSIGNER_A_URL=http://127.0.0.1:8101
ASSIGNER_B_URL=http://127.0.0.1:8102
REPLANNER_URL=http://127.0.0.1:8103
MONITOR_URL=http://127.0.0.1:8104
